# Copy this file to .env and paste your own key. NEVER commit .env.
GEMINI_API_KEY=

# Optional: change only if Google renames the Flash model.
RX_VLM_MODEL=gemini-2.5-flash

# Second reader (Groq vision). Leave empty until you create your own key.
GROQ_API_KEY=
# Optional model override, comma-separated fallback chain.
RX_GROQ_MODEL=qwen/qwen3.8-27b
